{% extends 'base.html.twig' %}

{% block body %}
<h1>Verify OTP</h1>

<form method="POST">
    <input type="hidden" name="email" value="{{ email }}">
    <label for="otp">OTP:</label>
    <input type="text" id="otp" name="otp" required>
    <button type="submit">Verify OTP</button>
</form>
{% endblock %}