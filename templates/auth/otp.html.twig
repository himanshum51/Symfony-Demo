{% extends 'base.html.twig' %}

{% block title %}Verify OTP{% endblock %}

{% block body %}
    <div class="card">
        <h2 class="text-2xl font-bold mb-4 text-center">Verify OTP</h2>
        <p class="text-gray-600 mb-4">Enter the OTP sent to your email. It is valid for 2 minutes.</p>
        <form id="otpForm" action="{{ path('app_otp_verify') }}" method="post">
            <div class="mb-4">
                <label for="otp" class="block text-sm font-medium text-gray-700">OTP Code</label>
                <input type="text" id="otp" name="otp" class="mt-1 p-2 w-full border rounded" required>
            </div>
            <button type="submit" class="btn-primary w-full">Verify</button>
            
            <p id="timer" class="timer">Time remaining: 2:00</p>
        </form>
        <p class="mt-4 text-center text-sm">
            Didn't receive the OTP? <a href="{{ path('app_register') }}" class="text-blue-500 hover:underline">Resend</a>
        </p>
    </div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script src="{{ asset('js/otp.js') }}"></script>
{% endblock %}